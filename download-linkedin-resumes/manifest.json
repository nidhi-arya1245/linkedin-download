{
  "manifest_version": 3,
  "name": "download-linkedin-resumes",
  "version": "1.0.0",
  "description": "Downloads resumes of new LinkedIn job applicants, skipping the ones already downloaded.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "activeTab",
    "debugger",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.licdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "download-linkedin-resumes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}